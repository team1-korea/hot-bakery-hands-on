# 이 파일을 .env.local로 복사해서 채운다. 비어 있으면 목으로, 값이 있으면 실제로 붙는다.
# 프론트 담당은 전부 비운 채로 `npm run dev`만 하면 된다.

# 운영자 화면(/admin) 비밀번호. 비어 있으면 아무도 들어갈 수 없다.
# ⚠️ 행사 전에 길게 바꿀 것. 대리 업로드가 생겨서 이 화면을 잡으면 아무 사진이나 붙일 수 있다.
OPERATOR_PASSCODE=

# 백엔드 주소. 비우면 같은 오리진의 라우트를 쓴다.
NEXT_PUBLIC_API_BASE_URL=

# 고정 도메인을 쓸 때 TV의 QR이 가리킬 주소. 비우면 요청 호스트를 그대로 쓴다.
NEXT_PUBLIC_SITE_URL=

# Avalanche 체인 ID. 43113=Fuji(기본), 43114=메인넷. 익스플로러 링크에 쓰인다.
NEXT_PUBLIC_CHAIN_ID=

# 확정 NFT 디자인 원본의 외부 URL. 원본 파일은 Git에 커밋하지 않는다.
# 참가자 브라우저가 직접 읽으므로 CORS에서 배포 오리진을 허용해야 한다.
NEXT_PUBLIC_CERTIFICATE_FRAME_URL=

# 목 파이프라인에서 각 단계가 실패할 확률(0~1). 실패 화면을 확인할 때만 쓴다. 기본 0.
MOCK_FAILURE_RATE=

# Supabase. Settings → Database → Connection string → URI.
# 비우면 메모리 저장소를 쓴다. 재시작하면 사라지지만 화면 개발에는 그편이 낫다.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=certificates

# Privy. App ID는 공개값이라 프론트가 이 저장소에서 바로 사용한다.
# 서버용 두 값을 비우면 로컬 백엔드는 목 인증으로 돈다. 운영에서는 누락 시 401로 잠긴다.
NEXT_PUBLIC_PRIVY_APP_ID=cmt2b8ry9002h0ckyshg4zz38
PRIVY_APP_ID=                # 위와 같은 App ID. 서버 토큰 검증용
PRIVY_APP_SECRET=

# Pinata → API Keys → New Key(Admin) → JWT. 만들 때 한 번만 보여준다.
PINATA_JWT=

# Supabase Cron이 /api/internal/sweep를 부를 때 쓰는 Bearer secret.
CRON_SECRET=

# 체인. RPC를 비우면 NEXT_PUBLIC_CHAIN_ID에 맞는 공개 RPC를 쓴다.
# Fuji는 배포 파일을 쓰고, 그 외 체인은 주소와 배포 블록을 함께 설정해야 한다.
AVALANCHE_RPC_URL=
CERTIFICATE_ADDRESS=
CERTIFICATE_DEPLOYMENT_BLOCK=

# MINTER_ROLE을 가진 서버 지갑의 개인키. 비우면 민팅만 실패하고 나머지는 돈다.
# NEXT_PUBLIC_ 접두어를 붙이면 브라우저 번들에 들어간다. 절대 붙이지 말 것.
MINTER_PRIVATE_KEY=
MINT_GAS_LIMIT=              # 비우면 300000

# 로컬/준비 환경에서만. 1이면 운영자 화면에 DB 초기화 버튼이 나타난다.
# 행사 운영 Vercel 환경에는 절대 넣지 않는다.
ALLOW_DB_RESET=
