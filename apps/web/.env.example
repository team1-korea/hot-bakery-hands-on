# 이 파일을 .env.local로 복사해서 채운다. 비어 있으면 목으로, 값이 있으면 실제로 붙는다.
# 프론트 담당은 전부 비운 채로 `npm run dev`만 하면 된다.

# 운영자 화면(/admin) 비밀번호. 비어 있으면 아무도 들어갈 수 없다.
# ⚠️ 행사 전에 길게 바꿀 것. 대리 업로드가 생겨서 이 화면을 잡으면 아무 사진이나 붙일 수 있다.
OPERATOR_PASSCODE=

# 백엔드 주소. 비우면 같은 오리진의 라우트를 쓴다.
NEXT_PUBLIC_API_BASE_URL=

# 고정 도메인을 쓸 때 TV의 QR이 가리킬 주소. 비우면 요청 호스트를 그대로 쓴다.
NEXT_PUBLIC_SITE_URL=

# Avalanche 체인 ID. 43113=Fuji(기본), 43114=메인넷. 익스플로러 링크에 쓰인다.
NEXT_PUBLIC_CHAIN_ID=

# 목 파이프라인에서 각 단계가 실패할 확률(0~1). 실패 화면을 확인할 때만 쓴다. 기본 0.
MOCK_FAILURE_RATE=

# Supabase. Settings → Database → Connection string → URI.
# 비우면 메모리 저장소를 쓴다. 재시작하면 사라지지만 화면 개발에는 그편이 낫다.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=certificates

# Privy. 비우면 목 인증으로 돈다.
# ⚠️ APP_ID만 넣고 검증 구현이 없으면 아무도 로그인하지 못한다(잠기는 쪽으로 실패한다).
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Pinata → API Keys → New Key(Admin) → JWT. 만들 때 한 번만 보여준다.
PINATA_JWT=

# 체인. 비우면 Fuji 공개 RPC와 deployments/43113.json의 주소를 쓴다.
AVALANCHE_RPC_URL=
CERTIFICATE_ADDRESS=

# MINTER_ROLE을 가진 서버 지갑의 개인키. 비우면 민팅만 실패하고 나머지는 돈다.
# NEXT_PUBLIC_ 접두어를 붙이면 브라우저 번들에 들어간다. 절대 붙이지 말 것.
MINTER_PRIVATE_KEY=
